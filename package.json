{
  "name": "activity-forecast",
  "version": "0.1.0",
  "private": true,
  "description": "GraphQL service ranking activities for the next 7 days from Open-Meteo forecasts",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.ts",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc",
    "format": "prettier --write .",
    "check": "prettier --check . && tsc && npm test"
  },
  "dependencies": {
    "@escape.tech/graphql-armor": "^3.2.0",
    "graphql": "^16.14.2",
    "graphql-yoga": "^5.24.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  }
}
